# Supabase Configuration (REQUIRED)
# Get these values from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here
VITE_SUPABASE_PROJECT_ID=your-project-id

# Sentry Error Monitoring (Optional but recommended for production)
# Get your DSN from: https://sentry.io/settings/projects/your-project/keys/
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
